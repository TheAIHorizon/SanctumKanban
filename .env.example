# ─────────────────────────────────────────────────────────────
# Sanctum Kanban — environment configuration
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Required (both local dev and Docker) ──────────────────────

# Session encryption key. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Public URL the app is served from.
NEXTAUTH_URL="http://localhost:3456"

# Port the app listens on (optional, defaults to 3456).
PORT=3456

# ── Docker Compose (docker compose up) ────────────────────────
# The `db` service is created with these credentials, and the app's
# DATABASE_URL is assembled from them automatically (host = `db`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sanctum_kanban

# ── Local development WITHOUT Docker ──────────────────────────
# If you run `npm run dev` against your own PostgreSQL, set this to a
# full connection string (host = localhost). Not needed for Docker —
# docker-compose.yml builds DATABASE_URL from the POSTGRES_* vars above.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sanctum_kanban?schema=public"

# ── Optional AI: see docs/ai-setup.md for all providers and workers ──
# Local-first. A hosted endpoint sends feature input to that provider.
# AI_BASE_URL is the base only; the app appends /chat/completions.
# Set ALL THREE model names to identifiers your endpoint actually serves.
# Examples and key instructions: Ollama, LM Studio/Bionic, Bionic-GPT,
# OmniRoute, OpenRouter, OpenAI, and Anthropic compatibility/gateways.
# For Docker Desktop -> host Ollama use host.docker.internal, not localhost.
# Linux and cross-machine listeners need additional networking configuration.
# AI_BASE_URL="http://host.docker.internal:11434/v1"
# AI_API_KEY=""
# AI_MODEL="your-exact-served-model-id"
# AI_COACH_MODEL="your-exact-served-model-id"
# AI_ASSESSMENT_MODEL="your-exact-served-model-id"
# AI_TIMEOUT_MS="90000"
# Legacy defaults if omitted: qwen3.8:27b / laguna-s / nemotron-3-super.
# Those are not installed for you. Model selection is independent per feature.
# AI_TIMEOUT_MS does not extend the coach or 180-second assessment-call limit.
# Assessments need docker-compose.assessments.yml; see docs/ai-setup.md.
# ASSESSMENT_RUNNER=1 belongs only in the dedicated worker, not the app.

# ── Optional: Cohort Builder ──────────────────────────────────
# Temporary password for accounts created by Cohort Builder Provision.
# Ask users to change it in Profile; a first-login change is not enforced.
# COHORT_TEMP_PASSWORD="replace-with-a-unique-temporary-password"

# Authentication currently supports email/password and guest observer access.
# OAuth is not enabled by adding provider keys; see DEPLOY.md for visibility.
