# ─────────────────────────────────────────────────────────────
# Sanctum Kanban — environment configuration
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Required (both local dev and Docker) ──────────────────────

# Session encryption key. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Public URL the app is served from.
NEXTAUTH_URL="http://localhost:3456"

# Port the app listens on (optional, defaults to 3456).
PORT=3456

# ── Docker Compose (docker compose up) ────────────────────────
# The `db` service is created with these credentials, and the app's
# DATABASE_URL is assembled from them automatically (host = `db`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sanctum_kanban

# ── Local development WITHOUT Docker ──────────────────────────
# If you run `npm run dev` against your own PostgreSQL, set this to a
# full connection string (host = localhost). Not needed for Docker —
# docker-compose.yml builds DATABASE_URL from the POSTGRES_* vars above.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sanctum_kanban?schema=public"

# ── Optional: AI task suggestions (provider-agnostic, OpenAI-compatible) ──────
# Sanctum favors LOCAL AI. Point these at any OpenAI-compatible endpoint:
#   Ollama:    AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=qwen3.8:27b
#   OpenWebUI: AI_BASE_URL=http://<host>/api           AI_MODEL=<served-model>
#   Hosted:    AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini  AI_API_KEY=sk-...
# If unset/unreachable, DCWF task suggestions fall back to keyword search
# (the feature degrades gracefully; it never blocks logging).
# From inside Docker, reach a host Ollama at http://host.docker.internal:11434/v1
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="qwen3.8:27b"
# AI_API_KEY=""

# ── Optional: OAuth providers (uncomment to enable) ───────────
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
