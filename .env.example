# ─────────────────────────────────────────────────────────────
# Sanctum Kanban — environment configuration
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Required (both local dev and Docker) ──────────────────────

# Session encryption key. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Public URL the app is served from.
NEXTAUTH_URL="http://localhost:3456"

# Port the app listens on (optional, defaults to 3456).
PORT=3456

# ── Docker Compose (docker compose up) ────────────────────────
# The `db` service is created with these credentials, and the app's
# DATABASE_URL is assembled from them automatically (host = `db`).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sanctum_kanban

# ── Local development WITHOUT Docker ──────────────────────────
# If you run `npm run dev` against your own PostgreSQL, set this to a
# full connection string (host = localhost). Not needed for Docker —
# docker-compose.yml builds DATABASE_URL from the POSTGRES_* vars above.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sanctum_kanban?schema=public"

# ── Optional: OAuth providers (uncomment to enable) ───────────
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
