// Prisma schema for Sanctum Kanban

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles
enum UserRole {
  ADMIN
  TEAM_LEAD
  MEMBER
  OBSERVER
}

// Team member roles (within a team)
enum TeamMemberRole {
  LEAD
  MEMBER
}

// Ticket status
enum TicketStatus {
  BACKLOG
  DOING
  DONE
}

// User model
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String
  lastName     String
  contactInfo  String?
  color        String   @default("#3b82f6") // Default blue color
  role         UserRole @default(MEMBER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  teamMemberships TeamMember[]
  assignedTickets Ticket[]         @relation("AssignedTickets")
  createdTickets  Ticket[]         @relation("CreatedTickets")
  archivedTickets Ticket[]         @relation("ArchivedTickets")
  cohortsCreated  Cohort[]         @relation("CohortCreatedBy")
  ticketHistory   TicketHistory[]
  announcements   Announcement[]
  comments        Comment[]
  dcwfTaskLinks   TicketDcwfTask[]

  // NextAuth
  accounts Account[]
  sessions Session[]
}

// Team model
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     TeamMember[]
  tickets     Ticket[]
  reflections Reflection[]
  tags        Tag[]
}

// Junction table for User-Team many-to-many relationship
model TeamMember {
  id        String         @id @default(cuid())
  userId    String
  teamId    String
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

// Ticket model
model Ticket {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TicketStatus @default(BACKLOG)
  position     Int          @default(0)
  dueDate      DateTime?
  teamId       String
  assigneeId   String?
  createdById  String
  archived     Boolean      @default(false)
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("CreatedTickets", fields: [createdById], references: [id])
  archivedBy  User?            @relation("ArchivedTickets", fields: [archivedById], references: [id], onDelete: SetNull)
  history     TicketHistory[]
  tags        TicketTag[]
  comments    Comment[]
  dcwfTasks   TicketDcwfTask[]
  reflections Reflection[]
}

// Tag model for labeling tickets
model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6b7280") // Gray default
  teamId    String? // Null = global tag, otherwise team-specific
  createdAt DateTime @default(now())

  // Relations
  team    Team?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tickets TicketTag[]

  @@unique([name, teamId])
}

// Junction table for Ticket-Tag many-to-many
model TicketTag {
  id       String @id @default(cuid())
  ticketId String
  tagId    String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tagId])
}

// Comment model for ticket discussions
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  ticketId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])
}

// Ticket history for tracking changes
model TicketHistory {
  id         String        @id @default(cuid())
  ticketId   String
  userId     String
  action     String // e.g., "created", "moved", "updated", "assigned"
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  details    String? // JSON string for additional details
  timestamp  DateTime      @default(now())

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

// Reflection board entries
model Reflection {
  id           String   @id @default(cuid())
  teamId       String
  wentWell     String?  @db.Text
  couldImprove String?  @db.Text
  actionItems  String?  @db.Text
  weekOf       DateTime
  ticketId     String? // Optional link to a ticket this reflection is about
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([teamId, weekOf])
  @@index([ticketId])
}

// Announcements
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  pinned    Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author User @relation(fields: [authorId], references: [id])
}

// NextAuth.js models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// DCWF (DoD Cyber Workforce Framework) reference data + linking
// Seeded from prisma/dcwf-data/*.json via `npm run db:import-dcwf`.
// Reference tables are read-only in the app.
// ─────────────────────────────────────────────────────────────

// Top-level DCWF category (IT, Cybersecurity, Cyber Effects, Intel, etc.)
model DcwfElement {
  id          String  @id @default(cuid())
  name        String  @unique // "Cybersecurity"
  code        String? // "CS"
  opr         String?
  description String? @db.Text

  workRoles DcwfWorkRole[]
}

// A DCWF work role, e.g. "451 - System Administrator"
model DcwfWorkRole {
  id          String  @id @default(cuid())
  code        String  @unique // "451"
  title       String // "System Administrator"
  elementId   String?
  description String? @db.Text
  // Curated flag: true = relevant to the current course/exercise (the ~15
  // enterprise-build + week-13 pentest roles). Instructors can toggle others on.
  inScope     Boolean @default(false)

  element DcwfElement?   @relation(fields: [elementId], references: [id], onDelete: SetNull)
  ksats   DcwfRoleKsat[]

  @@index([elementId])
}

// A DCWF KSAT (Knowledge, Skill, Ability, or Task).
// `ksatId` is the framework's own id (string — some carry a letter suffix, e.g. "1027A").
model DcwfKsat {
  id          String @id @default(cuid())
  ksatId      String @unique
  type        String // "Task" | "Knowledge" | "Skill" | "Ability"
  description String @db.Text

  roles       DcwfRoleKsat[]
  ticketLinks TicketDcwfTask[]

  @@index([type])
}

// Mapping table: which KSATs belong to which work role, and whether Core/Additional.
model DcwfRoleKsat {
  id               String  @id @default(cuid())
  workRoleId       String
  ksatId           String // FK to DcwfKsat.id (cuid)
  coreOrAdditional String? // "Core" | "Additional" | "Unassigned"

  workRole DcwfWorkRole @relation(fields: [workRoleId], references: [id], onDelete: Cascade)
  ksat     DcwfKsat     @relation(fields: [ksatId], references: [id], onDelete: Cascade)

  @@unique([workRoleId, ksatId])
  @@index([ksatId])
}

// Links a Ticket to a DCWF Task, with the student's per-task reflection note.
// A ticket can cover multiple DCWF tasks; each carries its own note.
model TicketDcwfTask {
  id          String   @id @default(cuid())
  ticketId    String
  ksatId      String // FK to DcwfKsat.id; app enforces the linked KSAT is type "Task"
  note        String?  @db.Text // "what I did for this task"
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ksat      DcwfKsat @relation(fields: [ksatId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([ticketId, ksatId])
  @@index([ksatId])
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────
// Cohort Builder: AI-assisted team formation from a placement survey.
// A Cohort holds imported SurveyResponses; a CohortRun is one solve
// (a chosen principle/weights) producing ProposedTeams the instructor
// reviews and then provisions into real Teams + accounts.
// ─────────────────────────────────────────────────────────────

model Cohort {
  id          String   @id @default(cuid())
  name        String
  term        String? // e.g. "Fall 2026"
  teamSize    Int      @default(3)
  notes       String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  provisioned Boolean  @default(false) // teams have been created from a run

  createdBy User             @relation("CohortCreatedBy", fields: [createdById], references: [id])
  responses SurveyResponse[]
  runs      CohortRun[]

  @@index([createdById])
}

// One student's normalized placement-survey answers.
// Skill ratings and availability are stored as JSON for flexibility across
// custom survey shapes; the importer maps CSV columns into these fields.
model SurveyResponse {
  id                String  @id @default(cuid())
  cohortId          String
  firstName         String
  lastName          String
  email             String
  // JSON: { "network": 1-5, "windowsAd": 1-5, "linux": 1-5, "database": 1-5,
  //         "web": 1-5, "programming": 1-5, "security": 1-5, "incident": 1-5 }
  skills            Json
  depthNote         String? @db.Text
  aspirationRole    String? // DCWF work-role code, e.g. "541"
  leadership        String? // "prefer" | "willing" | "no"
  // JSON string[] of weekday names the student can meet
  availDays         Json
  timePref          String? // "morning" | "afternoon" | "evening" | "none"
  workStyle         String? // "deep" | "generalist" | "coordination" | "flexible"
  partnerRequest    String?
  antiPartner       String?
  constraints       String? @db.Text
  // If this response has been provisioned into a real user, link it.
  provisionedUserId String?

  cohort          Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  proposedMembers ProposedMember[]

  @@index([cohortId])
}

// One solver execution: a principle/mode plus the weight vector used.
model CohortRun {
  id        String   @id @default(cuid())
  cohortId  String
  mode      String   @default("parity") // parity|coverage|mentorship|affinity|specialization|schedule|custom
  // JSON weight vector: { skillParity, pillarCoverage, mentorBalance, requestsHonored, scheduleFit }
  weights   Json
  seed      Int      @default(0) // rng seed for reproducibility
  score     Float? // final objective score
  metrics   Json? // cohort-level metrics snapshot
  watchList Json? // AI/solver-generated risk items
  createdAt DateTime @default(now())

  cohort Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teams  ProposedTeam[]

  @@index([cohortId])
}

// A proposed team within a run (not yet a real Team until provisioned).
model ProposedTeam {
  id        String  @id @default(cuid())
  runId     String
  name      String
  index     Int     @default(0)
  isHolding Boolean @default(false) // an incomplete "holding" team
  rationale String? @db.Text // AI-written "why these three"
  metrics   Json? // coverage, sharedDays, anchors, etc.

  run     CohortRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  members ProposedMember[]

  @@index([runId])
}

model ProposedMember {
  id             String  @id @default(cuid())
  proposedTeamId String
  responseId     String
  isLead         Boolean @default(false)
  teamRole       String? // short descriptor, e.g. "AD & domain lead"

  proposedTeam ProposedTeam   @relation(fields: [proposedTeamId], references: [id], onDelete: Cascade)
  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([proposedTeamId])
  @@index([responseId])
}
